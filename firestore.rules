rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('targetGoal' in data) || (data.targetGoal is string && data.targetGoal.size() <= 200)) &&
             (!('coachingStyle' in data) || (data.coachingStyle is string && data.coachingStyle.size() <= 100)) &&
             (!('studyCategory' in data) || (data.studyCategory is string && data.studyCategory.size() <= 100)) &&
             (!('consultTone' in data) || (data.consultTone is string && data.consultTone.size() <= 100));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
